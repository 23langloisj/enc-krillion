# Password required to create a game from the home page. Leave empty locally.
HOST_PASSWORD=

# Upstash Redis (REST). Required on Vercel — without it each serverless instance
# gets its own in-memory store and games break. Vercel's Upstash integration sets
# KV_REST_API_URL / KV_REST_API_TOKEN automatically; either pair works.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
